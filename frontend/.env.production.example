# Frontend Production Environment Variables

# Backend API URL (Render/Railway/Heroku)
VITE_API_URL=https://your-backend-domain.onrender.com/api

# Supabase Configuration (public keys only)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# IMPORTANT SECURITY NOTES:
# 1. Never add SUPABASE_SERVICE_ROLE_KEY to frontend environment
# 2. Only use ANON key which is safe for public exposure
# 3. All API calls go through backend which uses service role key
# 4. Ensure API_URL matches your production backend domain
