# Backend Production Environment Variables

PORT=5000
NODE_ENV=production

# Frontend URL (Vercel/Netlify)
CLIENT_URL=https://your-frontend-domain.vercel.app

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# IMPORTANT SECURITY NOTES:
# 1. Never commit this file with real values
# 2. Set these as environment variables in your hosting platform
# 3. SUPABASE_SERVICE_ROLE_KEY must NEVER be exposed to frontend
# 4. Ensure CLIENT_URL matches your production frontend domain for CORS
